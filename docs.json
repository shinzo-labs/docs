{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Shinzo Platform",
  "colors": {
    "primary": "#2563eb",
    "light": "#3b82f6",
    "dark": "#1d4ed8"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts/opentelemetry",
              "concepts/mcp"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/typescript/installation",
              "sdk/typescript/configuration",
              "sdk/typescript/examples",
              "sdk/typescript/api-reference"
            ]
          }
        ]
      },
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "Platform Features",
            "pages": [
              "platform/overview",
              "platform/dashboard",
              "platform/resources",
              "platform/traces",
              "platform/spans",
              "platform/metrics"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "platform/ingest-tokens",
              "platform/authentication"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/shinzo-labs",
          "icon": "github"
        },
        {
          "anchor": "Platform",
          "href": "https://app.shinzo.ai",
          "icon": "chart-line"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:austin@shinzolabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.shinzo.ai"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shinzo-labs",
      "x": "https://x.com/shinzolabs"
    }
  }
}

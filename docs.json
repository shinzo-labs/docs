            "pages": [
              "concepts/mcp",
              "concepts/opentelemetry"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/dashboard"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/typescript/installation",
              "sdk/typescript/configuration"
            ]
          },
          {
            "group": "Python SDK",
            "pages": [
              "sdk/python/installation",
              "sdk/python/configuration"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api/telemetry",
              "api/servers",
              "api/analytics"
            ]
          }
        ]
      }

{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Shinzo Platform",
  "colors": {
    "primary": "#2563eb",
    "light": "#3b82f6",
    "dark": "#1d4ed8"
  },
  "favicon": "/favicon.ico",
  "api": {
    "baseUrl": "https://api.app.shinzo.ai",
    "auth": {
      "method": "bearer"
    },
    "playground": {
      "mode": "show"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "quickstart"
            ]
          },
          {
            "group": "AI Tools",
            "pages": [
              "ai-tools/claude-code",
              "ai-tools/anthropic-sdk"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/mcp",
              "concepts/opentelemetry"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "platform/dashboard",
              {
                "group": "Onboarding",
                "pages": [
                  "platform/onboarding/mcp-observability"
                ]
              },
              "platform/mcp-dashboard"
            ]
          }
        ]
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/typescript/installation",
              "sdk/typescript/mcp-instrumentation",
              "sdk/typescript/configuration"
            ]
          },
          {
            "group": "Python SDK",
            "pages": [
              "sdk/python/installation",
              "sdk/python/mcp-instrumentation",
              "sdk/python/configuration"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/health"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "api/auth/register",
              "api/auth/login",
              "api/auth/verify",
              "api/auth/resend-verification",
              "api/auth/fetch-user",
              "api/auth/fetch-quota",
              "api/auth/oauth"
            ]
          },
          {
            "group": "AI Agents",
            "pages": [
              "api/agents/overview",
              "api/agents/create",
              "api/agents/list",
              "api/agents/get",
              "api/agents/update",
              "api/agents/delete",
              "api/agents/pause-resume",
              "api/agents/tasks",
              "api/agents/filesystem"
            ]
          },
          {
            "group": "Spotlight",
            "pages": [
              "api/spotlight/overview",
              "api/spotlight/messages",
              "api/spotlight/count-tokens",
              "api/spotlight/sessions",
              "api/spotlight/sharing"
            ]
          },
          {
            "group": "Tokens",
            "pages": [
              "api/tokens/ingest",
              "api/tokens/platform-keys"
            ]
          },
          {
            "group": "Provider Keys",
            "pages": [
              "api/provider-keys/overview",
              "api/provider-keys/test",
              "api/provider-keys/save",
              "api/provider-keys/list",
              "api/provider-keys/update",
              "api/provider-keys/delete"
            ]
          },
          {
            "group": "Telemetry",
            "pages": [
              "api/telemetry/ingest-traces",
              "api/telemetry/ingest-metrics",
              "api/telemetry/fetch"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/shinzo-labs",
          "icon": "github"
        },
        {
          "anchor": "Platform",
          "href": "https://app.shinzo.ai",
          "icon": "chart-line"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:austin@shinzolabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://app.shinzo.ai"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/shinzo-labs",
      "x": "https://x.com/shinzolabs"
    }
  }
}
